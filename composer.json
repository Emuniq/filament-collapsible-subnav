{
    "name": "emuniq/filament-collapsible-subnav",
    "description": "A Filament v3, v4 & v5 plugin for collapsible sub-navigation sidebar.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "filament",
        "laravel",
        "subnavigation",
        "sidebar",
        "collapsible"
    ],
    "homepage": "https://github.com/Emuniq/filament-collapsible-subnav",
    "support": {
        "issues": "https://github.com/Emuniq/filament-collapsible-subnav/issues",
        "source": "https://github.com/Emuniq/filament-collapsible-subnav"
    },
    "authors": [
        {
            "name": "Emuniq",
            "homepage": "https://emuniq.com",
            "role": "Maintainer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Emuniq\\FilamentCollapsibleSubnav\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Emuniq\\FilamentCollapsibleSubnav\\CollapsibleSubnavServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.1",
        "filament/filament": "^3.0|^4.0|^5.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
